{
  "initialize": {
    "protocolVersion": 1,
    "agentCapabilities": {
      "loadSession": true,
      "promptCapabilities": {
        "image": false
      }
    },
    "authMethods": [
      {
        "id": "cached_token",
        "name": "cached_token"
      }
    ]
  },
  "newSession": {
    "configOptions": [],
